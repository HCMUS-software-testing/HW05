          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SETUP_BASE_URL" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters" />
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def value = vars.get('baseUrl')
def matcher = (value =~ /^(https?):\/\/([^:\/]+)(?::(\d+))?/)
if (!matcher.find()) { throw new IllegalArgumentException('Invalid baseUrl: ' + value) }
vars.put('baseProtocol', matcher.group(1))
vars.put('baseHost', matcher.group(2))
vars.put('basePort', matcher.group(3) ?: (matcher.group(1) == 'https' ? '443' : '80'))</stringProp>
          </JSR223Sampler>
